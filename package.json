{
	"name": "cp-sync",
	"version": "1.0.0-beta1",
	"private": true,
	"workspaces": [
		"includes/ChurchPlugins"
	],
	"scripts": {
		"build:wp": "export NODE_ENV=production && wp-scripts build",
		"start:wp": "export NODE_ENV=development && wp-scripts start",
		"lint:wp": "wp-scripts lint-js",
		"format:wp": "wp-scripts format",
		"build:all": "npm run build:wp",
		"plugin-zip": "wp-scripts plugin-zip && zip -d cp-sync.zip README.md package.json"
	},
	"dependencies": {
		"@wordpress/api-fetch": "^6.50.0",
		"@wordpress/compose": "^6.30.0",
		"@wordpress/element": "^5.30.0",
		"@wordpress/scripts": "^27.3.0",
		"sass": "^1.42.1"
	},
	"files": [
		"assets/images/**",
		"includes/**",
		"vendor/**",
		"build/**",
		"*.php",
		"readme.txt",
		"languages/**",
		"LICENSE",
		"*.css"
	]
}

<?xml version="1.0"?>
<ruleset name="CP Sync">
	<description>
		Pragmatic PHPCS ruleset for CP Sync. Intentionally starts with the
		high-value sniffs — security, injection/escaping, i18n, and PHP 7.4
		compatibility — so `composer lint` is an achievable, meaningful gate
		rather than a wall of formatting noise on legacy code. Broader
		WordPress-Extra formatting rules can be layered in later, file by file.
	</description>

	<!-- Scan our own PHP only. -->
	<file>includes</file>
	<file>cp-sync.php</file>
	<file>uninstall.php</file>

	<!-- Never scan the submodule, vendored libraries, or build/deps output. -->
	<exclude-pattern>*/includes/ChurchPlugins/*</exclude-pattern>
	<exclude-pattern>*/includes/ChMS/planning-center-api/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/dist/*</exclude-pattern>
	<exclude-pattern>*/build/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/><!-- show sniff codes (s) + progress (p) -->
	<arg name="parallel" value="8"/>

	<!-- PHP version floor for compatibility sniffs. -->
	<config name="testVersion" value="7.4-"/>
	<rule ref="PHPCompatibilityWP"/>

	<!-- Security-critical WordPress sniffs (the Phase 1 concerns). -->
	<rule ref="WordPress.Security"/>
	<rule ref="WordPress.DB.PreparedSQL"/>
	<rule ref="WordPress.DB.PreparedSQLPlaceholders"/>
	<rule ref="WordPress.PHP.NoSilencedErrors"/>

	<!-- i18n correctness, scoped to this plugin's text domain. -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="cp-sync"/>
			</property>
		</properties>
	</rule>
</ruleset>
